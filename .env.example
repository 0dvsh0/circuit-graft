# Copy to .env and fill in locally. Never commit .env.
# The gated Tiny Aya repositories require accepting the licence on the model
# pages with this account first.
HF_TOKEN=
HF_ORG=

# Optional: generation / judging backends used by CuratorKIT and AuditKIT.
COHERE_API_KEY=
OPENAI_API_KEY=

# Optional: Weights & Biases (disabled by default in configs).
WANDB_API_KEY=
WANDB_DISABLED=true

# Where the heavy caches live (D: has the free space on the D1 machine).
HF_HOME=D:\coding\hackathon\circuit-graft\.cache\huggingface
HF_DATASETS_CACHE=D:\coding\hackathon\circuit-graft\.cache\huggingface\datasets
TORCH_HOME=D:\coding\hackathon\circuit-graft\.cache\torch
UV_CACHE_DIR=D:\coding\hackathon\circuit-graft\.cache\uv
